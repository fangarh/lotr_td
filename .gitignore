# Dependencies and package manager output
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local tooling/cache
.playwright-mcp/
.superpowers/
.worktrees/

# Logs and crash dumps
*.log
hs_err_pid*.log
replay_pid*.log
node-server.*.log
mono_crash.*.json

